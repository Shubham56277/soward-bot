DISCORD_APP_TOKEN=
DISCORD_APP_CLIENT_ID=
DISCORD_APP_CLIENT_SECRET=
GUILD_ID=
DEVELOPER_IDS=[]
NEXT_PUBLIC_BASE_URL=
PREFIX=!
# Use URL-encoded credentials. Do not leave example credentials in place.
DATABASE_URI=postgresql://YOUR_URL_ENCODED_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
# Optional local Docker PostgreSQL source of truth. `yarn db:local` generates
# these values and a matching DATABASE_URI; it never assumes a postgres user.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
NODE_ENV=development
# JSON values must be valid JSON on one line. `yarn doctor` reports the key,
# parser error, and no secret value when any JSON is malformed.
NODES=[]
SENTRY_DSN=
# Local Redis is installed and configured automatically by Dashboard Setup on Linux.
REDIS_URL=redis://127.0.0.1:6379/0
OXAPAY_MERCHANT_KEY=
IMAGIFY_API_URL=
MEDIA_PROXY_URL=http://host.docker.internal:5173
COMMAND_LOG_WEBHOOK_URL=
GUILD_CREATE_WEBHOOK_URL=
GUILD_DELETE_WEBHOOK_URL=
NO_PREFIX_WEBHOOK_URL=
PREMIUM_WEBHOOK_URL=
SHARD_WEBHOOK_URL=
ERROR_WEBHOOK_URL=   # Receives alerts for high-severity/critical errors (rate-limited)
SONG_REQUEST_CHANNEL_ID=   # Channel ID in your dev server to receive song requests
PREMIUM_EMOJI_ID=   # Custom emoji ID for premium badge (e.g. 1234567890123456789)

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Single key per provider (backward compatible):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
# done 
# ─── AI Cluster Manager (Multi-Key) ──────────────────────────────────────────
# Use these to add multiple API keys per provider for load balancing and failover.
# Each key becomes an independent node. The cluster manager routes to the healthiest one.
# Format: valid JSON array of strings (same model) or objects (per-key model override).
# Bare keys are not accepted: quote them and use a JSON array.
#
# Groq Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_API_KEYS=[{"key":"gsk_xxx","model":"llama-3.3-70b-versatile"},{"key":"gsk_yyy","model":"llama-3.1-8b-instant"},{"key":"gsk_zzz","model":"mixtral-8x7b-32768"}]
#
# Gemini Models: gemini-2.5-flash-lite, gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_API_KEYS=[{"key":"AIza_xxx","model":"gemini-2.5-flash-lite"},{"key":"AIza_yyy","model":"gemini-2.0-flash"}]
#
# OpenRouter Models: openrouter/free, meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free, mistralai/mistral-7b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_API_KEYS=[{"key":"sk-or-xxx","model":"meta-llama/llama-3.3-70b-instruct:free"},{"key":"sk-or-yyy","model":"qwen/qwen-2.5-72b-instruct:free"},{"key":"sk-or-zzz","model":"google/gemma-2-9b-it:free"}]
#
# HuggingFace Models: Qwen/Qwen2.5-7B-Instruct, mistralai/Mistral-7B-Instruct-v0.3, meta-llama/Llama-3.2-3B-Instruct, google/gemma-2-2b-it
HUGGINGFACE_TOKENS=[{"key":"hf_xxx","model":"Qwen/Qwen2.5-7B-Instruct"},{"key":"hf_yyy","model":"meta-llama/Llama-3.2-3B-Instruct"}]

# AI safety, latency, and capacity limits.
AI_TIMEOUT_SECONDS=8
AI_MAX_HISTORY=12
AI_MAX_OUTPUT_TOKENS=700
AI_RACE_MODE=false
AI_SESSION_TTL_SECONDS=21600
AI_USER_REQUESTS_PER_MINUTE=5
AI_GUILD_REQUESTS_PER_MINUTE=60
AI_MAX_CONCURRENCY=20
AI_RESPONSE_CACHE_SECONDS=600
